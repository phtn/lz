{
  "name": "drop-zone-beast",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "dev:cf": "bun run build && wrangler dev --env dev --live-reload",
    "preview": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "beast build src --out-dir .octane/beast && tsrx-tsc --noEmit -p tsconfig.beast.json && tsrx-tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "check": "bun run typecheck && bun run test && bun run build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "icons:build": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts",
    "icons:check": "bun scripts/build-icons.ts --svg src/lib/icons/svg --out src/lib/icons/icons.ts --check"
  },
  "dependencies": {
    "@beastjs/metal-fx": "^2.0.1",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/dom": "0.5.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@octanejs/adapter-cloudflare": "0.0.63",
    "@octanejs/base-ui": "0.1.69",
    "@octanejs/cmdk": "0.1.53",
    "@octanejs/day-picker": "0.0.34",
    "@octanejs/dnd-kit": "0.1.62",
    "@octanejs/lucide": "0.1.62",
    "@octanejs/nuqs": "0.1.56",
    "@octanejs/rsbuild-plugin": "0.1.69",
    "@octanejs/select": "0.1.19",
    "@octanejs/sonner": "0.1.63",
    "@octanejs/tanstack-router": "^0.2.10",
    "@octanejs/tanstack-table": "0.1.63",
    "beast-tsrx": "0.16.0",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.2",
    "firebase": "^13.1.0",
    "lenis": "^1.3.27",
    "octane": "0.16.0",
    "pdfjs-dist": "^6.4.299",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@beastjs/devtools": "^0.1.23",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@playwright/test": "^1.64.1",
    "@rsbuild/core": "^2.2.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsrx/typescript-plugin": "0.6.3",
    "@types/node": "^26.6.5",
    "convex-test": "^0.0.66",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
