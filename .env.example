PUBLIC_FIREBASE_API_KEY=your-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
PUBLIC_FIREBASE_APP_ID=your-app-id
PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Cloudflare Worker runtime variables. Configure production values with
# `wrangler secret put`; the R2 bucket itself is bound in wrangler.jsonc.
CONVEX_URL=https://your-deployment.convex.cloud
FILE_URL_SIGNING_KEY=replace-with-at-least-32-random-characters
