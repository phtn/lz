module "use strong";

import { useRef, useState } from 'octane'
import Topbar from '@/components/Topbar.btsx'
import SearchField from '@/components/SearchField.btsx'
import MobileSidebar from '@/components/MobileSidebar.btsx'
import type { WorkspaceLayoutProps } from '@/types/layout'

props { navigation, topbar, children }: WorkspaceLayoutProps
setup
  const [mobileNavOpen, setMobileNavOpen] = useState(false);
  const touchStartRef = useRef(0);

div.mobile-layout
  Topbar({...topbar} isMobile onOpenNavigation={() => setMobileNavOpen(true)} navigationOpen={mobileNavOpen})
  main#workspace-main.workspace-main
    div.workspace-search(className='hidden md:flex')
      SearchField(search={topbar.search} setSearch={topbar.setSearch} searchInputRef={topbar.searchInputRef})
    | #{children}
  div.mobile-nav-swipe-area(aria-hidden="true" onTouchStart={(event) => { touchStartRef.current = event.touches[0]?.clientX ?? 0; }} onTouchEnd={(event) => { if (touchStartRef.current - (event.changedTouches[0]?.clientX ?? touchStartRef.current) > 60) setMobileNavOpen(true); }})
  MobileSidebar(open={mobileNavOpen} onOpenChange={setMobileNavOpen} navigation={navigation})
