module "use client";
import { Tooltip as T } from "@octanejs/base-ui/tooltip";
import { cn } from "@/lib/utils";
import { createContext, use, useLayoutEffect, useRef, useState, useId } from "octane";
import type {ClassValue, HTMLAttributes, RefObject, OctaneNode, CSSProperties, ReactElement, Ref, PointerEventHandler, FocusEventHandler, KeyboardEventHandler } from "octane";
module
  type FluidTooltipOrientation = "horizontal" | "vertical" | "auto";
  type FluidTooltipSide = "top" | "right" | "bottom" | "left";
  type FluidTooltipAlign = "start" | "center" | "end";
  type FluidTooltipDirection = -1 | 0 | 1;
  interface FluidTooltipPayload {
    id: string;
    tooltipId: string;
    contentRef: RefObject<OctaneNode>;
    side: FluidTooltipSide;
    align: FluidTooltipAlign;
    sideOffset: number;
    showArrowRef: RefObject<boolean>;
    contentClassNameRef: RefObject<string | undefined>;
    className?: ClassValue;
  }
  interface FluidTooltipGroupContextValue {
    handle: T.Handle<FluidTooltipPayload>;
    className?: ClassValue;
    disabled: boolean;
    defaultSide: FluidTooltipSide;
    direction: FluidTooltipDirection;
    keyboardNavigation: boolean;
    registerPointerTarget: (element: HTMLElement) => void;
    registerKeyboardTarget: VoidFunction;
  }
  interface FluidTooltipRootContextValue {
    id: string;
    tooltipId: string;
    contentRef: RefObject<OctaneNode>;
    disabled: boolean;
    side?: FluidTooltipSide;
    align: FluidTooltipAlign;
    sideOffset: number;
    showArrowRef: RefObject<boolean>;
    contentClassNameRef: RefObject<string | undefined>;
  }
  const GroupContext = createContext<FluidTooltipGroupContextValue | null>(null);
  const RootContext = createContext<FluidTooltipRootContextValue | null>(null);
  const tokenStyle = {
    "--fluid-tooltip-surface": "var(--foreground)",
    "--fluid-tooltip-label": "var(--background)",
    "--fluid-tooltip-shadow": "rgb(0 0 0 / 0.28)",
  } as CSSProperties;
  function useGroupContext(component: string) {
    const context = use(GroupContext);
    if (!context) {
      throw new Error(`${component} must be used inside FluidTooltip (the tooltip group provider).`);
    }
    return context;
  }
  function useRootContext(component: string) {
    const context = use(RootContext);
    if (!context) {
      throw new Error(`${component} must be used inside FluidTooltipRoot.`);
    }
    return context;
  }
  interface FluidTooltipGroupProps {
    children: OctaneNode;
    orientation?: FluidTooltipOrientation;
    openDelay?: number;
    closeDelay?: number;
    disabled?: boolean;
    className?: string;
  }
  interface FluidTooltipRootProps {
    id: string;
    children: OctaneNode;
    side?: FluidTooltipSide;
    align?: FluidTooltipAlign;
    sideOffset?: number;
    disabled?: boolean;
  }
  interface FluidTooltipTriggerProps {
    children: ReactElement;
    className?: string;
    /**
     * The element Base UI renders the trigger as, instead of a `<button>` of its own. Pass one
     * whenever the trigger already has an interactive element, so it does not end up nested inside
     * another button. `disabled` belongs on this element: T.Trigger consumes its own `disabled`
     * prop for tooltip behaviour and never forwards it to the DOM.
     * Base UI calls a function `render` directly: assign the template to a local and return it,
     * since a direct `(props) => @{ … }` or a bare component needs Octane's render scope and crashes.
     */
    render?: ReactElement | ((props: HTMLAttributes<HTMLElement>) => ReactElement);
    keepOpenOnClick?: boolean;
    /** Any other prop is merged into the props the `render` component receives. */
    [renderProp: string]: unknown;
  }
  interface FluidTooltipContentProps {
    children: OctaneNode;
    className?: string;
    showArrow?: boolean;
  }
  export { FluidTooltipRoot, FluidTooltipTrigger, FluidTooltipContent };
// rendered from T.Root's children function; the group's className rides in the payload
component TooltipRootChildren
  props { payload }: {payload?: FluidTooltipPayload}
  T.Portal
    if payload
      T.Positioner(
        ~ align={payload.align}
        ~ className={cn("z-9999 h-[var(--positioner-height)] w-[var(--positioner-width)] max-w-[var(--available-width)] transition-[top,left,right,bottom,transform] duration-200 [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] data-instant:transition-none motion-reduce:transition-none")}
        ~ collisionPadding={8}
        ~ side={payload.side}
        ~ sideOffset={payload.sideOffset}
        ~ )
        T.Popup(
          ~ role="tooltip"
          ~ id={payload.tooltipId}
          ~ className={cn("relative origin-[var(--transform-origin)] rounded-md bg-foreground text-[12px] font-medium leading-none text-background shadow-[0_8px_24px_-8px_var(--fluid-tooltip-shadow)]", "h-[var(--popup-height,auto)] w-[var(--popup-width,auto)] max-w-[var(--available-width)] transition-[width,height,transform,opacity] duration-200 [transition-timing-function:cubic-bezier(0.22,1,0.36,1)] data-ending-style:scale-[0.98] data-ending-style:opacity-0 data-ending-style:duration-100 data-starting-style:scale-[0.96] data-starting-style:translate-y-1 data-starting-style:opacity-0 data-instant:transition-none motion-reduce:transition-none", payload.className, payload.contentClassNameRef.current)}
          ~ style={tokenStyle}
          ~ )
          T.Viewport(className={cn("relative box-border h-full w-full overflow-clip px-2 py-2", "[&_[data-previous]]:w-[calc(var(--popup-width)-1rem)] [&_[data-previous]]:translate-x-0 [&_[data-previous]]:opacity-0 [&_[data-previous]]:pointer-events-none [&_[data-previous]]:transition-none", "[&_[data-current]]:w-[calc(var(--popup-width)-1rem)] [&_[data-current]]:translate-x-0 [&_[data-current]]:opacity-100 [&_[data-current]]:transition-[translate,opacity] [&_[data-current]]:duration-[200ms,120ms]", "data-[activation-direction~='left']:[&_[data-current][data-starting-style]]:-translate-x-2 data-[activation-direction~='right']:[&_[data-current][data-starting-style]]:translate-x-2", "data-[activation-direction~='up']:[&_[data-current][data-starting-style]]:-translate-y-2 data-[activation-direction~='down']:[&_[data-current][data-starting-style]]:translate-y-2", "data-[activation-direction~='left']:[&_[data-previous][data-ending-style]]:translate-x-2 data-[activation-direction~='right']:[&_[data-previous][data-ending-style]]:-translate-x-2", "data-[activation-direction~='up']:[&_[data-previous][data-ending-style]]:translate-y-2 data-[activation-direction~='down']:[&_[data-previous][data-ending-style]]:-translate-y-2", "[[data-instant]_&_[data-previous]]:transition-none [[data-instant]_&_[data-current]]:transition-none motion-reduce:[&_[data-current]]:transition-none motion-reduce:[&_[data-previous]]:transition-none")}) #{payload.contentRef.current}
          if payload.showArrowRef.current
            T.Arrow(className="absolute size-2 rotate-45 bg-foreground data-[side=bottom]:-top-1 data-[side=left]:-right-0.5 data-[side=right]:-left-1 data-[side=top]:-bottom-1")

component FluidTooltipRoot
  props { id, children, side, align = "center", sideOffset = 8, disabled = false, }: FluidTooltipRootProps
  setup
    const tooltipId = useId();
    const contentRef = useRef<OctaneNode>(null);
    const showArrowRef = useRef(true);
    const contentClassNameRef = useRef<string | undefined>(undefined);

    const context: FluidTooltipRootContextValue = {
      id,
      tooltipId,
      contentRef,
      disabled,
      side,
      align,
      sideOffset,
      showArrowRef,
      contentClassNameRef,
    };
  RootContext(value={context})
    | #{children}
component FluidTooltipTrigger
  props { children, keepOpenOnClick = false, ref=null, ...props }: FluidTooltipTriggerProps & { ref?: Ref<HTMLElement|null> }
  setup
    const group = useGroupContext("FluidT.Trigger");
    const root = useRootContext("FluidT.Trigger");

    const payload: FluidTooltipPayload = {
      id: root.id,
      tooltipId: root.tooltipId,
      contentRef: root.contentRef,
      side: root.side ?? group.defaultSide,
      align: root.align,
      sideOffset: root.sideOffset,
      showArrowRef: root.showArrowRef,
      contentClassNameRef: root.contentClassNameRef,
      className: group.className,
    };



  T.Trigger(
    ~ {...props}
    ~ ref={ref as Ref<HTMLButtonElement>}
    ~ closeOnClick={!keepOpenOnClick}
    ~ disabled={group.disabled || root.disabled}
    ~ handle={group.handle}
    ~ payload={payload}
    ~ aria-describedby={root.tooltipId}
    ~ )
    | #{children}
component FluidTooltipContent
  props { children, className, showArrow = true, }: FluidTooltipContentProps
  setup
    const root = useRootContext("FluidT.Content");
    useLayoutEffect(() => {
      root.contentRef.current = children;
      root.contentClassNameRef.current = className;
      root.showArrowRef.current = showArrow;
    });
  | #{null}

props { children, orientation = "auto", openDelay = 150, closeDelay = 100, disabled = false, className, }: FluidTooltipGroupProps
setup
  const [handle] = useState(() => T.createHandle<FluidTooltipPayload>());

  const previousCenter = useRef<{
    x: number;
    y: number;
  } | null>(null);

  const [direction, setDirection] = useState<FluidTooltipDirection>(0);
  const [keyboardNavigation, setKeyboardNavigation] = useState(false);

  const context: FluidTooltipGroupContextValue = {
    handle,
    className,
    disabled,
    defaultSide: orientation === "vertical" ? "right" : "top",
    direction,
    keyboardNavigation,
    registerPointerTarget(element) {
      const bounds = element.getBoundingClientRect();
      const center = {
        x: bounds.left + bounds.width / 2,
        y: bounds.top + bounds.height / 2,
      };
      const previous = previousCenter.current;
      if (!previous) {
        setDirection(0);
      }
      else {
        const deltaX = center.x - previous.x;
        const deltaY = center.y - previous.y;
        const resolvedAxis = orientation === "horizontal"
          ? "x"
          : orientation === "vertical"
            ? "y"
            : Math.abs(deltaX) >= Math.abs(deltaY)
              ? "x"
              : "y";
        const delta = resolvedAxis === "x" ? deltaX : deltaY;
        setDirection(delta === 0 ? 0 : delta > 0 ? 1 : -1);
      }
      previousCenter.current = center;
      setKeyboardNavigation(false);
    },
    registerKeyboardTarget() {
      previousCenter.current = null;
      setDirection(0);
      setKeyboardNavigation(true);
    },
  };

  // T.Root calls this directly; see FluidTooltipTriggerProps.render for why the template is assigned first.
  const renderRootChildren = (state: { payload?: FluidTooltipPayload }) => {
    const content = @{ <TooltipRootChildren payload={state.payload} /> };
    return content;
  }

  const handleOnOpenChange = (open: boolean) => {
    if (!open) {
      previousCenter.current = null;
      setDirection(0);
    }
  }
T.Provider(delay={Math.max(0, openDelay)} closeDelay={Math.max(0, closeDelay)} timeout={50})
  GroupContext(value={context})
    | #{children}
  T.Root(
    ~ handle={handle}
    ~ disabled={disabled}
    ~ onOpenChange={handleOnOpenChange}
    ~ children={renderRootChildren}
    ~ )
