import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import { OctaneNode } from 'octane'


module
  type Props = {
    children?: OctaneNode
    className?: string
    onClick?: VoidFunction
  }
props { children, className, onClick }: Props
button(
  ~ className={cn("min-h-10 min-w-10",
  ~ 'hover:bg-muted [&>*]:text-foreground rounded-full',
  ~ 'dark:text-muted-foreground dark:rounded-sm dark:border-[1.5px] border-border dark:bg-deep dark:hover:[&>*]:text-indigo-300',
  ~ 'dark:shadow-[inset_0.75px_1px_0px_#444,inset_0_0_1px_#292929,inset_0_1px_0_#474747,0_2px_4px_#292929] dark:hover:bg-[#2b2b2b] active:dark:border-[#101010]',
  ~ 'dark:active:shadow-[inset_0.25px_0.5px_0px_#333,inset_0_0_0.5px_#393939,inset_0_0.25px_0_#575757,0_1px_0.5px_#3c3c3c] active:[&>*]:scale-80 active:[&>*]:opacity-70 transition-all duration-120 ease-out',
  ~  className)}
  ~onClick={onClick})
  fragment #{children}
