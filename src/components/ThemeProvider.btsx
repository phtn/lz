module
  "use strong";
  interface ThemeProviderProps { children: unknown }

  function getTheme(): Theme {
    return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
  }

  // Use the same snapshot on the server and during the first hydration render.
  function getServerTheme(): Theme { return 'light'; }

  function subscribeTheme(notify: () => void) {
    window.addEventListener('dropzone-theme-change', notify);
    return () => window.removeEventListener('dropzone-theme-change', notify);
  }

  function setTheme(theme: Theme) {
    const root = document.documentElement;
    root.classList.toggle('dark', theme === 'dark');
    root.style.colorScheme = theme;
    try { window.localStorage.setItem('dropzone-theme', theme); } catch { /* Private browsing may disable storage. */ }
    window.dispatchEvent(new Event('dropzone-theme-change'));
  }

  function toggleTheme() { setTheme(getTheme() === 'dark' ? 'light' : 'dark'); }

import { useSyncExternalStore } from 'octane'
import { ThemeContext, type Theme } from '@/context/theme'

props { children }: ThemeProviderProps
setup
  const theme = useSyncExternalStore(subscribeTheme, getTheme, getServerTheme);
  const value = { theme, setTheme, toggleTheme };

ThemeContext(value={value})
  | #{children}
