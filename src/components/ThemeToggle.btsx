import { use } from 'octane'
import { ThemeContext } from '@/context/theme'
import { Icon } from '@/lib/icons'

setup const { theme, toggleTheme } = use(ThemeContext);
button.theme-toggle(type="button" onClick={toggleTheme} aria-label={`Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`} aria-pressed={theme === 'dark'} title={`Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`})
  Icon(name="theme" size={18})
