module
  "use strong";
  interface DropZoneProps {
    isDragging: boolean;
    setIsDragging: (value: boolean) => void;
    addFiles: (files: FileList) => void;
    fileInputRef: { current: HTMLInputElement | null };
    onAddFiles: () => void;
    language: string;
    setLanguage: (value: string) => void;
  }

import { useRef } from 'octane'
import { CATEGORY_NAMES, OCR_LANGUAGES } from '@/constants/meta'
import { Icon } from '@/lib/icons'

props { isDragging, setIsDragging, addFiles, fileInputRef, onAddFiles, language, setLanguage }: DropZoneProps
setup const dragDepth = useRef(0);

section.upload-section(aria-label="Upload files")
  input.sr-only(ref={fileInputRef} type="file" multiple aria-label="Choose files to upload" onChange={(event) => { if (event.currentTarget.files) addFiles(event.currentTarget.files); event.currentTarget.value = ''; }})
  div.drop-surface(
    ~ className={isDragging ? 'is-dragging' : ''}
    ~ onDragEnter={(event) => { event.preventDefault(); dragDepth.current++; setIsDragging(true); }}
    ~ onDragOver={(event) => { event.preventDefault(); if (event.dataTransfer) event.dataTransfer.dropEffect = 'copy'; }}
    ~ onDragLeave={(event) => { event.preventDefault(); dragDepth.current = Math.max(0, dragDepth.current - 1); if (!dragDepth.current) setIsDragging(false); }}
    ~ onDrop={(event) => { event.preventDefault(); dragDepth.current = 0; setIsDragging(false); if (event.dataTransfer) addFiles(event.dataTransfer.files); }}
    ~ )
    div.drop-illustration(aria-hidden="true")
      span.drop-file.back
        Icon(name="folder" size={29})
      span.drop-file.front
        Icon(name="new-folder" size={30})
      span.drop-spark ✦
    div.drop-copy
      h2 #{isDragging ? 'Drop files to upload' : 'Upload and organize files'}
      div.drop-features
        p(className='flex items-center gap-2')
          Icon(name="shield-check" size={16})
          | On-device classification
        p(className='flex items-center gap-2')
          Icon(name="folder" size={16})
          | #{CATEGORY_NAMES.length} smart folders
    button.button-primary(type="button" onClick={onAddFiles} style="height: 36px" )
      Icon(name="add" size={18})
      span Choose files
  div.upload-footnote
    // div.infinity-lines(className="h-10 w-full grayscale opacity-40")
    // div.drop-lines.smooth-reveal(className="h-6 w-1/2 grayscale opacity-40")
    // span Images, PDFs, Office docs & more · Up to 20 MB per file
    label.language-select(className="hidden!")
      Icon(name="sparkles" size={14})
      span OCR language
      select(value={language} onChange={(event) => setLanguage(event.currentTarget.value)} aria-label="OCR language")
        each option in OCR_LANGUAGES key option.value
          option(value={option.value}) #{option.label}
