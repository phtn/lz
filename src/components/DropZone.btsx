module
  "use strong";
  interface DropZoneProps {
    isDragging: boolean;
    setIsDragging: (value: boolean) => void;
    isExpanded: boolean;
    onExpandedChange: (value: boolean) => void;
    addFiles: (files: FileList) => void;
    storageNotice: string | null;
    fileInputRef: { current: HTMLInputElement | null };
  }

import { useEffect, useRef } from 'octane'
import {Icon} from '@/lib/icons'
import { Button } from './ui'

props { isDragging, setIsDragging, isExpanded, onExpandedChange, addFiles, storageNotice, fileInputRef }: DropZoneProps
setup
  const openButtonRef = useRef<HTMLButtonElement | null>(null);
  const closeButtonRef = useRef<HTMLButtonElement | null>(null);
  const hasToggledRef = useRef(false);

  const openDropZone = () => {
    hasToggledRef.current = true;
    onExpandedChange(true);
  };

  const closeDropZone = () => {
    hasToggledRef.current = true;
    onExpandedChange(false);
  };

  useEffect(() => {
    if (!hasToggledRef.current) return;
    const target = isExpanded ? closeButtonRef.current : openButtonRef.current;
    requestAnimationFrame(() => target?.focus());
  }, [isExpanded]);

section
  input(
    ~ className="sr-only dark:bg-14141b"
    ~ ref={fileInputRef}
    ~ type="file"
    ~ multiple
    ~ onChange={(event) => {
    ~   if (event.currentTarget.files) addFiles(event.currentTarget.files);
    ~   event.currentTarget.value = '';
    ~ }}
    ~ )

  section#drop-zone-surface(
    ~ className={[
    ~   "relative isolate flex min-h-[118px] items-center overflow-hidden rounded-2xl border border-dashed border-sidebar-border bg-[radial-gradient(circle_at_86%_18%,color-mix(in_oklab,var(--brand)_9%,transparent),transparent_27%),linear-gradient(135deg,var(--surface)_0%,var(--background)_100%)] px-[22px] py-5 shadow-[0_1px_2px_rgba(25,31,55,0.04)] transition-[min-height,border-color,box-shadow,transform] duration-[620ms] ease-[cubic-bezier(0.22,1,0.36,1)] before:pointer-events-none before:absolute before:inset-[18px] before:z-0 before:rounded-[13px] before:border before:border-dashed before:border-brand/40 before:opacity-0 before:content-[''] before:scale-[0.985] before:transition-[opacity,transform] before:duration-[480ms] before:ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-brand/70 hover:shadow-[0_12px_32px_color-mix(in_oklab,var(--brand)_9%,transparent)] dark:rounded-[4px] dark:border-[0.33px] dark:border-solid dark:border-[#050505] dark:bg-[linear-gradient(180deg,#303030_0%,#2b2b2b_100%)] dark:shadow-[inset_0_1px_0_#3b3b3b] dark:before:rounded-[2px] dark:before:border-brand/55 dark:hover:border-brand/50 dark:hover:shadow-[inset_0_1px_0_#3d3d3d] max-[620px]:items-start max-[620px]:p-[17px]",
    ~   isExpanded && "min-h-[clamp(480px,calc(100dvh-150px),760px)] border-brand/60 bg-[radial-gradient(circle_at_50%_42%,color-mix(in_oklab,var(--brand)_13%,transparent),transparent_34%),radial-gradient(circle_at_90%_8%,color-mix(in_oklab,var(--brand)_12%,transparent),transparent_25%),linear-gradient(145deg,var(--surface)_0%,var(--background)_100%)] shadow-[0_24px_60px_color-mix(in_oklab,var(--brand)_12%,transparent)] before:opacity-100 before:scale-100 dark:border-brand dark:bg-[radial-gradient(circle_at_50%_42%,rgb(255_255_255_/_7%),transparent_35%),linear-gradient(180deg,#303030_0%,#252525_100%)] dark:shadow-[inset_0_1px_0_#444,0_0_0_1px_#0a0a0a] max-[620px]:min-h-[clamp(430px,calc(100dvh-112px),680px)] max-[620px]:before:inset-3",
    ~   isDragging && !isExpanded && '-translate-y-0.5 border-brand/70 bg-brand-soft shadow-[0_12px_32px_color-mix(in_oklab,var(--brand)_9%,transparent)]',
    ~   isDragging && isExpanded && 'translate-y-0 border-brand shadow-[0_0_0_4px_color-mix(in_oklab,var(--brand)_8%,transparent),0_24px_60px_color-mix(in_oklab,var(--brand)_14%,transparent)]'
    ~ ]}
    ~ onDragEnter={(event) => { event.preventDefault(); setIsDragging(true); }}
    ~ onDragOver={(event) => { event.preventDefault(); event.dataTransfer.dropEffect = 'copy'; }}
    ~ onDragLeave={(event) => {
    ~   if (!event.currentTarget.contains(event.relatedTarget as Node | null)) setIsDragging(false);
    ~ }}
    ~ onDrop={(event) => {
    ~   event.preventDefault();
    ~   setIsDragging(false);
    ~   if (event.dataTransfer.files.length > 0) addFiles(event.dataTransfer.files);
    ~ }}
    ~ onKeyDown={(event) => { if (event.key === 'Escape' && isExpanded) closeDropZone(); }}
    ~ aria-label="File upload drop zone"
    ~ )
    div(
      ~ className={[
      ~   'relative z-[1] grid w-full grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-[17px] transition-[visibility] max-[1320px]:grid-cols-[auto_minmax(0,1fr)] max-[820px]:grid-cols-[auto_minmax(0,1fr)] max-[620px]:items-start',
      ~   isExpanded
      ~     ? 'invisible pointer-events-none [transition-delay:240ms]'
      ~     : 'visible pointer-events-auto [transition-delay:0s]'
      ~ ]}
      ~ aria-hidden={isExpanded}
      ~ inert={isExpanded}
      ~ )
      div(className={['grid size-12 place-items-center rounded-[13px] bg-brand-soft text-brand shadow-[inset_0_0_0_1px_color-mix(in_oklab,var(--brand)_8%,transparent)] transition-[opacity,transform] duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)] dark:rounded-full dark:border-1.5 dark:border-[#111] dark:bg-[#242424] dark:shadow-[inset_0_1px_0_#454545,0_2px_4px_#111]', isExpanded && '-translate-y-[30px] opacity-0']})
        Icon(name="server" size={20})
      div(className={['min-w-0 transition-[opacity,transform] duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)]', isExpanded && '-translate-y-[30px] opacity-0']})
        span(className="mb-[5px] block text-[9px] font-bold uppercase tracking-[0.09em] text-brand") Storage
        h2(className="m-0 text-[15px] tracking-[-0.02em]") #{isDragging ? 'Release to organize' : 'Drop files here to organize them'}

      div(className={['flex flex-wrap items-center justify-end gap-3.5 transition-[opacity,transform] duration-[420ms] ease-[cubic-bezier(0.22,1,0.36,1)] max-[1320px]:col-span-full max-[1320px]:pl-[65px] max-[820px]:col-span-full max-[820px]:justify-between max-[820px]:pl-[65px] max-[620px]:items-stretch max-[620px]:flex-col max-[620px]:pl-0 max-[620px]:[&_button]:w-full', isExpanded && 'translate-y-[30px] opacity-0']})
        div.flex.items-center.space-x-4
          Button(
            ~ ref={openButtonRef}
            ~ className="dark:!rounded-sm dark:!bg-[#353535] dark:!bg-none dark:!text-[#e0e0e0] dark:!shadow-[inset_0_1px_0_#4a4a4a,0_0_0_1px_#111]"
            ~ type="button"
            ~ aria-controls="expanded-drop-zone"
            ~ aria-expanded={isExpanded}
            ~ onClick={openDropZone}
            ~ )
            // div(className="flex items-center justify-center size-9 aspect-square")
            span Auto Sort
            Icon(name="mechanics" className="size-4")
        div.flex.items-center.space-x-4
          Button( variant="secondary" className="dark:!rounded-sm dark:!bg-[#353535] dark:!text-[#d2d2d2] dark:!shadow-[inset_0_1px_0_#4a4a4a,0_0_0_1px_#111]" onClick={() => fileInputRef.current?.click()})
            span  Special Drop
            Icon(name="wand" className="size-3.5")
        Button(variant="default" className="dark:!rounded-sm dark:!bg-brand dark:!text-[#181818] dark:!shadow-[inset_0_1px_0_#efefef,0_0_0_1px_#111]" type="button" onClick={() => fileInputRef.current?.click()})
          span Browse files
          Icon(name="new-folder")

    div#expanded-drop-zone(
      ~ className={[
      ~   'absolute inset-0 z-[1] flex items-center justify-center p-[68px_34px_42px] transition-[opacity,transform,visibility] ease-[cubic-bezier(0.22,1,0.36,1)] max-[620px]:p-[62px_28px_34px]',
      ~   isExpanded
      ~     ? 'visible pointer-events-auto translate-y-0 scale-100 opacity-100 [transition-duration:260ms,540ms,0s] [transition-delay:180ms,100ms,0s]'
      ~     : 'invisible pointer-events-none translate-y-[22px] scale-[0.985] opacity-0 [transition-duration:180ms,420ms,0s] [transition-delay:0s,0s,420ms]'
      ~ ]}
      ~ aria-hidden={!isExpanded}
      ~ inert={!isExpanded}
      ~ )
      button(
        ~ className="absolute right-[34px] top-[34px] grid size-[38px] cursor-pointer place-items-center rounded-[11px] border border-sidebar-border bg-surface/80 text-muted-foreground shadow-[0_1px_2px_rgba(25,31,55,0.04)] backdrop-blur-xl transition-all duration-150 hover:-translate-y-px hover:border-border hover:text-brand dark:rounded-full dark:border-[#111] dark:bg-[#262626] dark:shadow-[inset_0_1px_0_#444,0_3px_6px_#151515] max-[620px]:right-[25px] max-[620px]:top-[25px]"
        ~ ref={closeButtonRef}
        ~ type="button"
        ~ onClick={closeDropZone}
        ~ aria-label="Close drop zone"
        ~ )
        Icon(name="close" size={18})

      div(className="flex w-[min(100%,620px)] flex-col items-center text-center")
        div(className="mb-7 grid size-[92px] place-items-center rounded-[28px] dark:border-[0.33px] border-brand/20 bg-brand text-brand-foreground shadow-[0_20px_40px_color-mix(in_oklab,var(--brand)_24%,transparent),0_0_0_12px_color-mix(in_oklab,var(--brand)_6%,transparent)] dark:rounded-full dark:border-[#111] dark:bg-[#2b2b2b] dark:text-brand dark:shadow-[inset_0_1px_0_#4b4b4b,0_5px_12px_#111,0_0_0_10px_#242424] max-[620px]:mb-6 max-[620px]:size-[78px] max-[620px]:rounded-[23px]" aria-hidden="true")
          Icon(name={isDragging ? 'dropzone' : 'chute'} size={44})
        span(className="mb-3 block text-[10px] font-bold uppercase tracking-[0.14em] text-brand") #{isDragging ? 'Ready when you are' : 'Drop Zone Ready '}
        h2(className="m-0 text-[clamp(24px,4vw,32px)] leading-[1.05] tracking-[-0.045em] max-[620px]:text-[clamp(25px,9vw,34px)]") #{isDragging ? 'Release to start organizing' : 'Drop your files anywhere here'}
        div(className="mt-7 flex flex-col items-center gap-3.5")
          button(type="button" onClick={() => fileInputRef.current?.click()} className="inline-flex h-11 min-w-[150px] cursor-pointer items-center justify-center gap-2 rounded-xl border-0 bg-brand px-5 text-xs font-[650] text-brand-foreground shadow-[0_12px_26px_color-mix(in_oklab,var(--brand)_24%,transparent)] transition-all duration-150 hover:-translate-y-px hover:bg-brand-strong hover:shadow-[0_15px_30px_color-mix(in_oklab,var(--brand)_30%,transparent)] dark:rounded-sm dark:border dark:border-[#111] dark:shadow-[inset_0_1px_0_#efefef,0_4px_10px_#171717] dark:text-background text-base! tracking-normal")
            | or browse files

  if storageNotice
    div(
      ~ className={[
      ~   'flex items-start gap-[9px] rounded-[10px] bg-warning/10 px-[13px] text-[10.5px] leading-[1.45] text-warning-foreground transition-[max-height,margin,padding,border-width,opacity,transform] duration-[360ms] ease-[cubic-bezier(0.22,1,0.36,1)]',
      ~   isExpanded
      ~     ? 'mt-0 max-h-0 translate-y-[18px] overflow-hidden border-0 py-0 opacity-0'
      ~     : 'mt-2.5 max-h-[120px] translate-y-0 border border-warning/30 py-[11px] opacity-100'
      ~ ]}
      ~ role="status"
      ~ )
      Icon(name="shield-check")
      | #{storageNotice}
