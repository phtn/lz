module
  "use strong";
  interface FileDashboardProps { initialLibrary?: StoredFile[] }
  const LazyFileDetails = lazy(() => import('./FileDetails.btsx'));
  const LazyQueue = lazy(() => import('./Queue.btsx'));

import { lazy, useEffect, useEffectEvent, useLinkedState, useRef, useState, useSyncExternalStore } from 'octane'
import { authenticatedFetch, getCurrentUser, getServerAuthUser, subscribeToAuthState, signInWithGoogle } from '@/lib/firebase'
import { uploadFile } from '@/lib/upload'
import type { CategoryName, QueueItem, StoredFile } from '@/types/file'
import { MAX_FILE_SIZE, SHOW_EMPTY_FOLDERS } from '@/constants/meta'
import { analyzeFile } from '@/utils/ocr'
import { createThumbnail } from '@/utils/thumbnail'
import DropZone from './DropZone.btsx'
import { Icon } from '@/lib/icons'
import { formatBytes } from '@/utils/helpers'
import Library from './Library.btsx'
import WorkspaceLayout from '@/layouts/WorkspaceLayout.btsx'

props { initialLibrary = [] }: FileDashboardProps
setup
  const currentUser = useSyncExternalStore(subscribeToAuthState, getCurrentUser, getServerAuthUser);
  const accountUid = currentUser?.uid;
  const [queue, setQueue] = useLinkedState(currentUser?.uid, () => [] as QueueItem[]);
  const [library, setLibrary, getLibrary] = useLinkedState<string | undefined, StoredFile[]>(currentUser?.uid, (_uid, previous) => previous ? [] as StoredFile[] : initialLibrary);
  const [isDragging, setIsDragging] = useState(false);
  const [search, setSearch] = useState('');
  const [categorySelection, setActiveCategory] = useState<CategoryName>('All');
  const [isQueueOpen, setIsQueueOpen] = useState(false);
  const [selectedFileId, setSelectedFileId, getSelectedFileId] = useLinkedState(currentUser?.uid, () => null as string | null);
  const [language, setLanguage, getLanguage] = useState('eng');
  const [loading, setLoading] = useLinkedState(currentUser?.uid, () => Boolean(currentUser));
  const [notice, setNotice] = useLinkedState(currentUser?.uid, () => '');
  const [announcement, setAnnouncement] = useLinkedState(currentUser?.uid, () => '');
  const fileInputRef = useRef<HTMLInputElement | null>(null);
  const searchInputRef = useRef<HTMLInputElement | null>(null);
  const queueRef = useRef<QueueItem[]>([]);
  const runningRef = useRef(0);
  const controllersRef = useRef(new Map<string, AbortController>());
  const libraryControllerRef = useRef<AbortController | null>(null);
  const deletedIdsRef = useRef(new Set<string>());
  const [deletedIds, setDeletedIds] = useLinkedState(currentUser?.uid, () => new Set<string>());
  const mountedRef = useRef(true);
  const lastRefreshRef = useRef(0);
  const [searchResults, setSearchResults, getSearchResults] = useLinkedState(`${currentUser?.uid}:${search}`, () => [] as StoredFile[]);
  const [searchBusy, setSearchBusy] = useLinkedState(`${currentUser?.uid}:${search}`, () => false);
  useEffect(() => {
    if (!accountUid || search.trim().length < 2) return;
    const controller = new AbortController();
    const timer = window.setTimeout(async () => {
      setSearchBusy(true);
      try {
        const response = await authenticatedFetch(`/api/files?search=${encodeURIComponent(search.trim())}`, { signal: controller.signal });
        const payload = await response.json() as { files?: StoredFile[] };
        if (response.ok && !controller.signal.aborted) setSearchResults(payload.files ?? []);
      } catch { /* Local filename and summary matches remain available when offline. */ }
      finally { if (!controller.signal.aborted) setSearchBusy(false); }
    }, 300);
    return () => { window.clearTimeout(timer); controller.abort(); };
  });

  const syncQueue = (update: (items: QueueItem[]) => QueueItem[]) => {
    const next = update(queueRef.current);
    queueRef.current = next;
    if (mountedRef.current) setQueue(next);
  };
  const updateQueueItem = (id: string, changes: Partial<QueueItem>) => {
    syncQueue((items) => items.map((item) => item.id === id ? { ...item, ...changes } : item));
  };

  const applyLibrary = useEffectEvent((files: StoredFile[], startedAt: number) => {
    const deletedSnapshot = new Set(deletedIdsRef.current);
    setLibrary((current) => {
      const newlyUploaded = current.filter((file) => Date.parse(file.createdAt) >= startedAt && !files.some((remote) => remote.id === file.id));
      return [...newlyUploaded, ...files].filter((file) => !deletedSnapshot.has(file.id));
    });
    lastRefreshRef.current = Date.now();
  });

  const refreshLibrary = async (controller: AbortController) => {
    const user = getCurrentUser();
    if (!user) return;
    libraryControllerRef.current?.abort();
    libraryControllerRef.current = controller;
    const startedAt = Date.now();
    try {
      const response = await authenticatedFetch('/api/files', { signal: controller.signal });
      const payload = await response.json() as { files?: StoredFile[]; error?: string };
      if (!response.ok) throw new Error(payload.error ?? 'Your library could not be loaded.');
      if (getCurrentUser()?.uid !== user.uid || controller.signal.aborted) return;
      applyLibrary(payload.files ?? [], startedAt);
    } catch (error) {
      if (!controller.signal.aborted) setNotice(error instanceof Error ? error.message : 'Your library could not be loaded.');
    } finally { if (!controller.signal.aborted) setLoading(false); }
  };

  const resetAccount = useEffectEvent(() => {
    const uid = getCurrentUser()?.uid;
    for (const item of queueRef.current) {
      if (item.ownerUid !== uid) {
        controllersRef.current.get(item.id)?.abort();
        if (item.previewUrl) URL.revokeObjectURL(item.previewUrl);
      }
    }
    libraryControllerRef.current?.abort();
    queueRef.current = queueRef.current.filter((item) => item.ownerUid === uid);
    deletedIdsRef.current.clear();
  });
  const trackLibraryRequest = useEffectEvent((controller: AbortController) => { libraryControllerRef.current = controller; });
  useEffect(() => {
    const controller = new AbortController();
    resetAccount();
    trackLibraryRequest(controller);
    const startedAt = Date.now();
    if (accountUid) {
      void (async () => {
        try {
          const response = await authenticatedFetch('/api/files', { signal: controller.signal });
          const payload = await response.json() as { files?: StoredFile[]; error?: string };
          if (!response.ok) throw new Error(payload.error ?? 'Your library could not be loaded.');
          if (!controller.signal.aborted) applyLibrary(payload.files ?? [], startedAt);
        } catch (error) {
          if (!controller.signal.aborted) setNotice(error instanceof Error ? error.message : 'Your library could not be loaded.');
        } finally { if (!controller.signal.aborted) setLoading(false); }
      })();
    }
    return () => controller.abort();
  });

  useEffect(() => {
    const focusSearch = (event: KeyboardEvent) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); searchInputRef.current?.focus(); }
    };
    const refreshOnFocus = () => {
      if (document.visibilityState === 'visible' && Date.now() - lastRefreshRef.current > 10 * 60 * 1000) void refreshLibrary(new AbortController());
    };
    window.addEventListener('keydown', focusSearch);
    document.addEventListener('visibilitychange', refreshOnFocus);
    const timer = window.setInterval(refreshOnFocus, 60 * 1000);
    return () => { window.removeEventListener('keydown', focusSearch); document.removeEventListener('visibilitychange', refreshOnFocus); window.clearInterval(timer); };
  });
  useEffect(() => {
    mountedRef.current = true;
    return () => {
      mountedRef.current = false;
      controllersRef.current.forEach((controller) => controller.abort());
      libraryControllerRef.current?.abort();
      queueRef.current.forEach((item) => { if (item.previewUrl) URL.revokeObjectURL(item.previewUrl); });
    };
  });

  const processQueue = () => {
    const startNext = () => {
      while (runningRef.current < 2 && mountedRef.current) {
        const item = queueRef.current.find((candidate) => candidate.status === 'queued');
        if (!item) break;
        runningRef.current++;
        updateQueueItem(item.id, { status: 'reading', progress: 0, error: undefined });
        const controller = new AbortController();
        controllersRef.current.set(item.id, controller);
        void (async () => {
          try {
            const classification = item.classification ?? await analyzeFile(item.file, (progress, detail) => {
              if (!controller.signal.aborted) updateQueueItem(item.id, { progress: Math.min(40, progress * 0.4), detail });
            }, item.language);
            controller.signal.throwIfAborted();
            if (getCurrentUser()?.uid !== item.ownerUid) throw new Error('Sign in to the original account and add this file again.');
            updateQueueItem(item.id, { status: 'classifying', progress: 40, classification });
            const form = new FormData();
            form.append('file', item.file); form.append('uploadId', item.id);
            const thumbnail = await createThumbnail(item.file);
            controller.signal.throwIfAborted();
            if (thumbnail) form.append('thumbnail', thumbnail, 'thumbnail.webp');
            for (const key of ['category', 'kind', 'confidence', 'excerpt', 'method', 'text', 'ocrConfidence', 'pagesRead', 'pageCount', 'warning'] as const) {
              const value = classification[key];
              if (value !== undefined) form.append(key, String(value));
            }
            updateQueueItem(item.id, { status: 'uploading', progress: 40, uploadedBytes: 0 });
            const stored = await uploadFile(form, item.ownerUid,
              ({ percent, loaded, total, bytesPerSecond }) => updateQueueItem(item.id, { status: 'uploading', progress: 40 + percent * 0.55, uploadedBytes: loaded, totalBytes: total, bytesPerSecond }),
              () => updateQueueItem(item.id, { status: 'filing', progress: 95, detail: 'Checking with Jev & filing your original…' }), controller.signal);
            controller.signal.throwIfAborted();
            if (!mountedRef.current || getCurrentUser()?.uid !== item.ownerUid) return;
            setLibrary((current) => [stored, ...current.filter((file) => file.id !== stored.id)]);
            updateQueueItem(item.id, { status: 'done', progress: 100, storedFile: stored, classification: { ...classification, category: stored.category, kind: stored.kind, confidence: stored.confidence, jev: stored.jev } });
            setAnnouncement(`${stored.name} uploaded, sorted into ${stored.category}, and ready for remote viewing.${stored.jev && ['review', 'unavailable', 'skipped'].includes(stored.jev.status) ? ' Please review the folder classification.' : ''}`);
          } catch (error) {
            if (!controller.signal.aborted) updateQueueItem(item.id, { status: 'error', error: error instanceof Error ? error.message : 'Upload could not be completed.' });
          } finally {
            controllersRef.current.delete(item.id);
            runningRef.current--;
            startNext();
          }
        })();
      }
    };
    startNext();
  };

  const openFilePicker = async () => {
    setNotice('');
    if (getCurrentUser()) { fileInputRef.current?.click(); return; }
    try { await signInWithGoogle(); fileInputRef.current?.click(); }
    catch (error) { setNotice(error instanceof Error ? error.message : 'Sign in to upload your files.'); }
  };
  const addFiles = (fileList: FileList | File[]) => {
    const user = getCurrentUser();
    if (!user) { setNotice('Sign in with Google, then drop your files again to save them to your private library.'); return; }
    const files = Array.from(fileList);
    if (!files.length) return;
    const nextItems: QueueItem[] = files.map((file) => ({
      id: crypto.randomUUID(), file, ownerUid: user.uid, language: getLanguage(), progress: 0,
      status: file.size === 0 || file.size > MAX_FILE_SIZE ? 'error' : 'queued',
      error: file.size === 0 ? 'This file is empty. Choose a file with contents.' : file.size > MAX_FILE_SIZE ? 'This file exceeds the 20 MB limit.' : undefined,
      previewUrl: file.type.startsWith('image/') && file.size <= MAX_FILE_SIZE ? URL.createObjectURL(file) : undefined
    }));
    setNotice(''); setIsQueueOpen(true);
    syncQueue((items) => [...items, ...nextItems]);
    processQueue();
  };
  const retryItem = (id: string) => {
    const item = queueRef.current.find((candidate) => candidate.id === id);
    if (!item || item.file.size === 0 || item.file.size > MAX_FILE_SIZE) return;
    updateQueueItem(id, { status: 'queued', error: undefined, progress: 0 });
    processQueue();
  };
  const removeQueueItem = (id: string) => {
    const item = queueRef.current.find((candidate) => candidate.id === id);
    if (item && !['queued', 'done', 'error'].includes(item.status)) return;
    if (item?.previewUrl) URL.revokeObjectURL(item.previewUrl);
    syncQueue((items) => items.filter((candidate) => candidate.id !== id));
  };
  const clearCompleted = () => {
    queueRef.current.filter((item) => item.status === 'done').forEach((item) => { if (item.previewUrl) URL.revokeObjectURL(item.previewUrl); });
    syncQueue((items) => items.filter((item) => item.status !== 'done'));
  };
  const selectFile = (id: string) => {
    const result = getSearchResults().find((file) => file.id === id);
    if (result) setLibrary((current) => current.some((file) => file.id === id) ? current : [...current, result]);
    setSelectedFileId(id);
  };
  const selectCategory = (category: CategoryName) => { setActiveCategory(category); };
  const updateStoredFile = (file: StoredFile) => { setLibrary((current) => current.map((item) => item.id === file.id ? file : item)); };
  const deleteStoredFile = async (id: string) => {
    const ownerUid = getCurrentUser()?.uid;
    const file = getLibrary().find((item) => item.id === id);
    if (!file) return;
    const wasSelected = getSelectedFileId() === id;
    deletedIdsRef.current.add(id);
    setDeletedIds(new Set(deletedIdsRef.current));
    setLibrary((current) => current.filter((item) => item.id !== id));
    if (wasSelected) setSelectedFileId(null);
    try {
      const response = await authenticatedFetch(`/api/files/${encodeURIComponent(id)}`, { method: 'DELETE' });
      if (!response.ok) throw new Error('The file could not be deleted. Please retry.');
    } catch (error) {
      if (getCurrentUser()?.uid !== ownerUid) return;
      deletedIdsRef.current.delete(id);
      setDeletedIds(new Set(deletedIdsRef.current));
      setLibrary((current) => current.some((item) => item.id === id) ? current : [file, ...current]);
      setNotice(error instanceof Error ? error.message : 'The file could not be deleted.');
    }
  };
  const categoryCounts = (() => {
    const counts = new Map<CategoryName, number>();
    library.forEach((file) => counts.set(file.category, (counts.get(file.category) ?? 0) + 1));
    return counts;
  })();
  const activeCategory = SHOW_EMPTY_FOLDERS || categorySelection === 'All' || (categoryCounts.get(categorySelection) ?? 0) > 0 ? categorySelection : 'All';
  const filteredLibrary = (() => {
    const needle = search.trim().toLowerCase();
    const merged = [...library, ...searchResults.filter((result) => !library.some((file) => file.id === result.id))];
    return merged.filter((file) => !deletedIds.has(file.id) && (activeCategory === 'All' || file.category === activeCategory) &&
      (!needle || searchResults.some((result) => result.id === file.id) || `${file.name} ${file.kind} ${file.category} ${file.excerpt}`.toLowerCase().includes(needle)));
  })();
  const activeQueueCount = queue.filter((item) => !['done', 'error'].includes(item.status)).length;
  const totalBytes = library.reduce((total, file) => total + file.size, 0);
  const firstName = currentUser?.displayName?.trim().split(/\s+/)[0] || 'friend';
  const selectedFile = library.find((file) => file.id === selectedFileId) ?? searchResults.find((file) => file.id === selectedFileId) ?? null;

  const previewFiles = selectedFile && !filteredLibrary.some((file) => file.id === selectedFile.id) ? [selectedFile, ...filteredLibrary] : filteredLibrary;

div.dashboard
  WorkspaceLayout(
    ~ navigation={{ activeQueueCount, library, activeCategory, setActiveCategory: selectCategory, categoryCounts, onOpenQueue: () => setIsQueueOpen(true) }}
    ~ topbar={{ search, setSearch, searchInputRef, onAddFiles: () => void openFilePicker() }}
    ~ )
    div.workspace-content
      header.workspace-heading.workspace-welcome
        div
          p.eyebrow YOUR PERSONAL WORKSPACE
          h2 Welcome back, #{firstName}.
          p A little more order. A little less on your mind.
        span.workspace-private
          Icon(name="shield-check" size={16})
          | Your private library
      section.workspace-overview(aria-label="Library overview" aria-busy={loading})
        article
          Icon(name="files" size={23})
          div
            strong #{loading ? '—' : library.length}
            span #{library.length === 1 ? 'File in your library' : 'Files in your library'}
        article
          Icon(name="folder" size={23})
          div
            strong #{loading ? '—' : categoryCounts.size}
            span Smart folders used
        article
          Icon(name="cloud" size={23})
          div
            strong #{loading ? '—' : formatBytes(totalBytes)}
            span Stored originals
      if notice
        div.notice(role="alert" className="bg-red-400")
          Icon(name="alert-fill" size={18})
          span #{notice}
          button.icon-button(type="button" onClick={() => setNotice('')} aria-label="Dismiss message")
            Icon(name="close")
      DropZone(isDragging={isDragging} setIsDragging={setIsDragging} addFiles={addFiles} fileInputRef={fileInputRef} onAddFiles={() => void openFilePicker()} language={language} setLanguage={setLanguage})
      div.workspace-library-divider(aria-hidden="true")
      Library(filteredLibrary={filteredLibrary} categoryCounts={categoryCounts} activeCategory={activeCategory} setActiveCategory={selectCategory} search={search} selectedFileId={selectedFileId} selectFile={selectFile} onAddFiles={() => void openFilePicker()} loading={loading || searchBusy} onRefresh={() => { if (getCurrentUser()) { setLoading(true); void refreshLibrary(new AbortController()); } }})
  span.sr-only(role="status" aria-live="polite" aria-atomic="true") #{announcement}
  if selectedFile
    try
      LazyFileDetails(files={previewFiles} onSelect={selectFile} file={selectedFile} onClose={() => setSelectedFileId(null)} deleteFile={deleteStoredFile} onUpdate={updateStoredFile})
    pending
      div.preview-loading(role="status")
        Icon(name="spinner-ring" size={22})
        span Opening preview…
    catch error, reset
      div.notice.preview-loading(role="alert")
        span File preview could not be opened.
        button.button-secondary(type="button" onClick={reset}) Retry
        button.icon-button(type="button" onClick={() => setSelectedFileId(null)} aria-label="Close preview")
          Icon(name="close")
  if queue.length > 0 || isQueueOpen
    try
      LazyQueue(queue={queue} activeQueueCount={activeQueueCount} removeItem={removeQueueItem} retryItem={retryItem} isOpen={isQueueOpen} onClose={() => setIsQueueOpen(false)} onOpen={() => setIsQueueOpen(true)} onView={(id: string) => { selectFile(id); setIsQueueOpen(false); }} onClear={clearCompleted})
    pending
      span.sr-only(role="status") Preparing upload activity…
    catch error, reset
      div.notice.preview-loading(role="alert")
        span Upload activity could not be shown.
        button.button-secondary(type="button" onClick={reset}) Retry
