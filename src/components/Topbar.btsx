module
  "use strong";
  interface TopbarProps extends WorkspaceTopbarProps {
    isMobile?: boolean;
    onOpenNavigation?: VoidFunction;
    navigationOpen?: boolean;
  }

import { useState, useSyncExternalStore } from 'octane'
import type { WorkspaceTopbarProps } from '@/types/layout'
import { getAuthStateReady, getCurrentUser, getServerAuthStateReady, getServerAuthUser, signInWithGoogle, signOutCurrentUser, subscribeToAuthState } from '@/lib/firebase'
import { Icon } from '@/lib/icons'
import SearchField from './SearchField.btsx'
import ThemeToggle from './ThemeToggle.btsx'


props { search, setSearch, searchInputRef, onAddFiles, isMobile = false, onOpenNavigation, navigationOpen = false }: TopbarProps
setup
  const currentUser = useSyncExternalStore(subscribeToAuthState, getCurrentUser, getServerAuthUser);
  const ready = useSyncExternalStore(subscribeToAuthState, getAuthStateReady, getServerAuthStateReady);
  const [busy, setBusy] = useState(false);
  const [authError, setAuthError] = useState('');
  const handleAuthClick = async () => {
    setBusy(true); setAuthError('');
    try {
      if (currentUser) await signOutCurrentUser();
      else await signInWithGoogle();
    } catch (error) { setAuthError(error instanceof Error ? error.message : 'Sign-in could not be completed.'); }
    finally { setBusy(false); }
  };

header.topbar-header
  div.topbar
    h1.topbar-title
      span DropZone
      // a(href="/" aria-label="DropZone home")
    if !isMobile
      SearchField(search={search} setSearch={setSearch} searchInputRef={searchInputRef})
    div.topbar-actions
      if isMobile
        ThemeToggle
      button.account-button(type="button" disabled={busy || !ready} onClick={() => void handleAuthClick()} aria-label={currentUser ? 'Sign out' : 'Sign in with Google'} title={currentUser?.email ?? 'Sign in with Google'})
        Icon(name="person" size={18} className="account-icon")
        span #{currentUser ? currentUser.displayName?.split(' ')[0] ?? 'Account' : 'Sign in'}

      if isMobile
        button.icon-button.mobile-nav-trigger(type="button" onClick={onOpenNavigation} aria-label="Open navigation" aria-controls="mobile-navigation" aria-expanded={navigationOpen})
          Icon(name="menu" size={20})
  if authError
    div.auth-error(role="alert")
      span #{authError}
      button.icon-button(type="button" onClick={() => setAuthError('')} aria-label="Dismiss sign-in error")
        Icon(name="close")
