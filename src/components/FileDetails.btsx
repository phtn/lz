module
  "use strong";
  interface FileDetailsProps {
    file: StoredFile;
    files: StoredFile[];
    onSelect: (id: string) => void;
    onClose: () => void;
    deleteFile: (id: string) => void | Promise<void>;
    onUpdate: (file: StoredFile) => void;
  }
import { lazy, useEffect, useLinkedState, useRef, useState } from 'octane'
import type { StoredFile, CategoryName } from '@/types/file'
import { CATEGORY_NAMES } from '@/constants/meta'
import { authenticatedFetch } from '@/lib/firebase'
import { downloadOriginal } from '@/lib/download'
import { formatBytes, getFileIcon } from '@/utils/helpers'
import CategoryPill from './CategoryPill.btsx'
import { Icon } from '@/lib/icons'
import ImageViewer from './ImageViewer.btsx'
module const PdfViewer = lazy(() => import('./PdfViewer.btsx'));
props { file, files, onSelect, onClose, deleteFile, onUpdate }: FileDetailsProps
setup
  const dialogRef = useRef<HTMLDialogElement | null>(null);
  const swipeRef = useRef<{ id: number; x: number; y: number } | null>(null);
  const downloadControllerRef = useRef<AbortController | null>(null);
  const [downloading, setDownloading] = useLinkedState(file.id, () => false);
  const [details, setDetails, getDetails] = useLinkedState(file.id, () => file);
  const [tab, setTab] = useLinkedState(file.id, () => 'preview');
  const [message, setMessage] = useLinkedState(file.id, () => '');
  const [copied, setCopied] = useLinkedState(file.id, () => false);
  const [confirmDelete, setConfirmDelete] = useLinkedState(file.id, () => false);
  const [saving, setSaving] = useState(false);
  const [metadataLoading, setMetadataLoading] = useLinkedState(file.id, () => true);
  const alternatives = Object.entries(details.jev?.probabilities ?? {}).sort((a, b) => b[1] - a[1]).slice(0, 3);
  const index = files.findIndex((item) => item.id === file.id);
  const navigate = (offset: number) => { const target = files[index + offset]; if (target) onSelect(target.id); };
  useEffect(() => {
    const dialog = dialogRef.current;
    const previous = document.activeElement as HTMLElement | null;
    dialog?.showModal();
    const overflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    return () => { dialog?.close(); document.body.style.overflow = overflow; previous?.focus(); };
  });
  useEffect(() => {
    const controller = new AbortController();
    const request = authenticatedFetch(`/api/files/${encodeURIComponent(file.id)}?metadata=1`, { signal: controller.signal });
    void (async () => {
      try {
        const response = await request;
        const payload = await response.json() as { file?: StoredFile; error?: string };
        if (!response.ok || !payload.file) throw new Error(payload.error ?? 'File details could not be refreshed.');
        if (!controller.signal.aborted) setDetails(payload.file);
      } catch (error) { if (!controller.signal.aborted) setMessage(error instanceof Error ? error.message : 'File details could not be refreshed.'); }
      finally { if (!controller.signal.aborted) setMetadataLoading(false); }
    })();
    return () => { controller.abort(); downloadControllerRef.current?.abort(); };
  });
  const handleTabKey = (event: KeyboardEvent) => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    const target = event.currentTarget as HTMLButtonElement;
    const buttons = Array.from(target.parentElement?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);
    const next = event.key === 'Home' ? 0 : event.key === 'End' ? 1 : tab === 'preview' ? 1 : 0;
    setTab(next === 0 ? 'preview' : 'text'); buttons[next]?.focus();
  };
  const moveFolder = async (category: CategoryName) => {
    if (saving) return;
    setSaving(true); setMessage('');
    try {
      const response = await authenticatedFetch(`/api/files/${encodeURIComponent(file.id)}`, { method: 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ category }) });
      const payload = await response.json() as { file?: StoredFile; error?: string };
      if (!response.ok || !payload.file) throw new Error(payload.error ?? 'The folder could not be updated.');
      if (dialogRef.current?.open) setDetails((current) => current.id === payload.file!.id ? payload.file! : current);
      onUpdate(payload.file);
    } catch (error) { setMessage(error instanceof Error ? error.message : 'The folder could not be updated.'); }
    finally { setSaving(false); }
  };
  const copyText = async () => {
    try { await navigator.clipboard.writeText(details.text ?? details.excerpt); setCopied(true); }
    catch { setMessage('Copy is unavailable in this browser. Select the text and copy it manually.'); }
  };
  const download = async () => {
    if (downloading) return;
    const controller = new AbortController();
    downloadControllerRef.current = controller;
    setDownloading(true); setMessage('');
    try { await downloadOriginal(file.id, file.name, controller.signal); }
    catch (error) { if (!controller.signal.aborted) setMessage(error instanceof Error ? error.message : 'The file could not be downloaded. Please try again.'); }
    finally { if (!controller.signal.aborted) setDownloading(false); }
  };

dialog.file-dialog(ref={dialogRef} aria-labelledby="preview-title" onCancel={(event) => { event.preventDefault(); onClose(); }} onClick={(event) => { if (event.target === event.currentTarget) { const rect = event.currentTarget.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) onClose(); } }})
  header.preview-header
    div.preview-title
      h2#preview-title #{file.name}
    button.icon-button(type="button" onClick={onClose} aria-label="Close file preview" autoFocus)
      Icon(name="close" size={22})
  div.preview-body
    section.preview-main
      div#preview-content.preview-content(
        ~ role="tabpanel" aria-labelledby={tab === 'text' ? 'text-tab' : 'preview-tab'}
        ~ onPointerDown={(event) => {
        ~   const target = event.target as HTMLElement;
        ~   if (event.button !== 0 || target.closest('.image-viewer, button, a, input, select, video, audio')) { swipeRef.current = null; return; }
        ~   if (swipeRef.current) { swipeRef.current = null; return; }
        ~   swipeRef.current = { id: event.pointerId, x: event.clientX, y: event.clientY };
        ~   (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
        ~ }}
        ~ onPointerUp={(event) => {
        ~   const start = swipeRef.current; swipeRef.current = null;
        ~   if (!start || start.id !== event.pointerId) return;
        ~   const dx = event.clientX - start.x, dy = event.clientY - start.y;
        ~   if (Math.abs(dx) >= 60 && Math.abs(dx) > Math.abs(dy) * 1.5) navigate(dx < 0 ? 1 : -1);
        ~ }}
        ~ onPointerCancel={() => { swipeRef.current = null; }}
        ~ onLostPointerCapture={() => { swipeRef.current = null; }}
        ~ )
        if tab === 'text'
          div.extracted-text
            div.text-toolbar
              span #{metadataLoading ? 'Loading extracted text…' : details.method ?? 'File analysis'}
              button.button-secondary(type="button" onClick={() => void copyText()} disabled={!details.text && !details.excerpt})
                Icon(name={copied ? 'check' : 'copy'} size={16})
                | #{copied ? 'Copied' : 'Copy text'}
            pre #{details.text || details.excerpt || 'No readable text was found. You can still preview or download the complete original.'}
        elseif file.mimeType.startsWith('image/')
          ImageViewer(file={details} onNavigate={navigate})
        elseif file.mimeType === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')
          try
            PdfViewer(file={details})
          pending
            div.preview-status(role="status") Loading PDF viewer…
          catch error
            div.preview-status(role="alert") The PDF viewer could not be loaded. Open the original to view it.
        elseif file.mimeType.startsWith('video/')
          div.media-preview
            video(src={details.url} controls playsInline preload="metadata" aria-label={file.name})
        elseif file.mimeType.startsWith('audio/')
          div.media-preview
            Icon(name="play" size={48})
            audio(src={details.url} controls preload="metadata" aria-label={file.name})
        else
          div.document-preview
            span.document-icon
              Icon(name={getFileIcon(file.name, file.mimeType)} size={56})
            h3 #{file.kind}
            p #{details.excerpt || 'Your original is safely filed. Open or download it to view in your preferred app.'}
            a.button-primary(href={details.url} target="_blank" rel="noopener noreferrer")
              Icon(name="external-link" size={17})
              | Open original
      div.preview-tabs
        div(role="tablist" aria-label="File content")
          button(className={tab === 'preview' ? 'is-active' : ''} type="button" role="tab" aria-selected={tab === 'preview'} aria-controls="preview-content" id="preview-tab" tabIndex={tab === 'preview' ? 0 : -1} onKeyDown={handleTabKey} onClick={() => setTab('preview')}) Preview
          button(className={tab === 'text' ? 'is-active' : ''} type="button" role="tab" aria-selected={tab === 'text'} aria-controls="preview-content" id="text-tab" tabIndex={tab === 'text' ? 0 : -1} onKeyDown={handleTabKey} onClick={() => setTab('text')}) Extracted text
        div.file-navigation
          button.icon-button(type="button" disabled={index <= 0} onClick={() => navigate(-1)} aria-label="Previous file")
            Icon(name="arrow-left" size={18})
          span #{index + 1} / #{files.length}
          button.icon-button(type="button" disabled={index < 0 || index >= files.length - 1} onClick={() => navigate(1)} aria-label="Next file")
            Icon(name="arrow-right" size={18})
    aside.preview-insights
      div.preview-file-actions
        p #{formatBytes(file.size)} · #{new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(file.createdAt))}
        div
          button.icon-button(type="button" onClick={() => void download()} disabled={downloading} aria-busy={downloading} aria-label="Download original" title="Download original")
            Icon(name={downloading ? 'spinner-ring' : 'download'} size={20})
          a.icon-button(href={details.url} target="_blank" rel="noopener noreferrer" aria-label="Open original in a new tab" title="Open original")
            Icon(name="external-link" size={19})
      span.eyebrow File insights
      div.ready-card
        Icon(name="check" size={20})
        div
          strong Filed & ready
          p Sign in on any device to view this original.
      section.insight-section
        h3 Smart classification
        CategoryPill(category={details.category})
        p #{details.kind}
        if details.jev?.status === 'corrected'
          p Folder confirmed by you
        else
          div.folder-estimate
            div.confidence-label
              span #{details.jev?.status === 'accepted' ? 'Jev confidence' : 'Local folder estimate'}
              strong #{details.confidence}%
            div.progress-track
              span(style={{ width: `${details.confidence}%` }})
        if details.jev
          div.jev-assessment
            strong #{details.jev.status === 'accepted' ? 'Automatic classification passed' : details.jev.status === 'corrected' ? 'Reviewed classification' : 'Folder review recommended'}
            p #{details.jev.status === 'corrected' ? 'Your folder choice overrides the original model suggestion. Original scores are retained for evaluation.' : details.jev.reason}
            if details.jev.suggestedCategory
              p #{`Jev suggested: ${details.jev.suggestedCategory}`}
            if details.jev.confidence !== undefined
              div.confidence-label
                span Model confidence
                strong #{Math.round(details.jev.confidence * 100)}%
            if details.jev.evidenceProbability !== undefined
              div.confidence-label
                span Clear text evidence
                strong #{Math.round(details.jev.evidenceProbability * 100)}%
            if alternatives.length > 0
              details.jev-alternatives
                summary Category probabilities
                each alternative in alternatives key alternative[0]
                  div.confidence-label
                    span #{alternative[0]}
                    strong #{Math.round(alternative[1] * 100)}%
            if details.jev.model
              small #{details.jev.model}
            p Model certainty is not a guarantee of correctness.
        if details.jev && ['review', 'unavailable', 'skipped'].includes(details.jev.status)
          button.button-secondary(type="button" disabled={saving || metadataLoading} onClick={() => void moveFolder(getDetails().category)}) Confirm current folder
        label.move-folder
          span Move to folder
          select(value={details.category} disabled={saving || metadataLoading} onChange={(event) => void moveFolder(event.currentTarget.value as CategoryName)} aria-label="Move file to folder")
            each category in CATEGORY_NAMES key category
              option(value={category}) #{category}
      section.insight-section
        h3 Text recognition
        p #{details.method ?? 'File type + filename'}
        if details.ocrConfidence !== undefined
          div.confidence-label
            span OCR confidence
            strong #{details.ocrConfidence}%
        if details.pageCount
          p #{details.pagesRead ?? 0} of #{details.pageCount} pages analyzed
        if details.warning
          p.extraction-warning #{details.warning}
        span.private-note
          Icon(name="shield-check" size={16})
          | #{details.jev && details.jev.status !== 'skipped' ? 'OCR on your device · text classified with Jev' : 'OCR analyzed on your device'}
      if message
        p.extraction-warning(role="alert") #{message}
      section.insight-section
        h3 Content at a glance
        p.summary-text #{details.excerpt || 'No readable text was found. This file was organized using its name and file type.'}
      div.preview-delete
        if confirmDelete
          div.confirm-delete
            p Remove this file from your cloud library?
            button.button-danger(type="button" onClick={() => { void deleteFile(file.id); onClose(); }}) Delete file
            button.button-secondary(type="button" onClick={() => setConfirmDelete(false)}) Keep file
        else
          button.text-button(type="button" onClick={() => setConfirmDelete(true)}) Delete file
