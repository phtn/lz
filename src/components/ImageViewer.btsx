module
  "use strong";
  interface ImageViewerProps { file: StoredFile }
  type Point = { x: number; y: number };
import { useEffect, useLinkedState, useRef } from 'octane'
import type { StoredFile } from '@/types/file'
import { Icon } from '@/lib/icons'
props { file }: ImageViewerProps
setup
  const [zoom, setZoom, getZoom] = useLinkedState(file.id, () => 1);
  const [rotation, setRotation] = useLinkedState(file.id, () => 0);
  const [pan, setPan, getPan] = useLinkedState<string, Point>(file.id, () => ({ x: 0, y: 0 }));
  const [loaded, setLoaded] = useLinkedState(file.url, () => false);
  const [failed, setFailed] = useLinkedState(file.url, () => false);
  const stageRef = useRef<HTMLDivElement | null>(null);
  const pointers = useRef(new Map<number, Point>());
  const previous = useRef<Point | null>(null);
  const pinch = useRef<{ distance: number; zoom: number } | null>(null);
  const reset = () => { setZoom(1); setPan({ x: 0, y: 0 }); setRotation(0); };
  const changeZoom = (value: number) => { setZoom(Math.min(5, Math.max(0.5, value))); };
  useEffect(() => {
    const stage = stageRef.current;
    const wheel = (event: WheelEvent) => { event.preventDefault(); changeZoom(getZoom() * Math.exp(-event.deltaY * 0.002)); };
    stage?.addEventListener('wheel', wheel, { passive: false });
    return () => stage?.removeEventListener('wheel', wheel);
  });
  const distance = () => {
    const [a, b] = Array.from(pointers.current.values());
    return a && b ? Math.hypot(a.x - b.x, a.y - b.y) : 0;
  };
  const releasePointer = (event: PointerEvent) => {
    pointers.current.delete(event.pointerId); previous.current = null; pinch.current = null;
  };

div.image-viewer(tabIndex={0} onKeyDown={(event) => {
  ~ if (event.key === '+' || event.key === '=') { event.preventDefault(); changeZoom(getZoom() + 0.25); }
  ~ else if (event.key === '-') { event.preventDefault(); changeZoom(getZoom() - 0.25); }
  ~ else if (event.key === '0') { event.preventDefault(); reset(); }
  ~ }})
  div.image-stage(
    ~ ref={stageRef}
    ~ aria-label="Image preview. Pinch or use the controls to zoom; drag to pan."
    ~ onDoubleClick={() => { setZoom(getZoom() > 1 ? 1 : 2); setPan({ x: 0, y: 0 }); }}
    ~ onPointerDown={(event) => {
    ~   (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
    ~   pointers.current.set(event.pointerId, { x: event.clientX, y: event.clientY });
    ~   previous.current = { x: event.clientX, y: event.clientY };
    ~   if (pointers.current.size === 2) pinch.current = { distance: distance(), zoom: getZoom() };
    ~ }}
    ~ onPointerMove={(event) => {
    ~   if (!pointers.current.has(event.pointerId)) return;
    ~   pointers.current.set(event.pointerId, { x: event.clientX, y: event.clientY });
    ~   if (pointers.current.size === 2 && pinch.current && pinch.current.distance > 0) changeZoom(pinch.current.zoom * distance() / pinch.current.distance);
    ~   else if (previous.current) { const current = getPan(); setPan({ x: current.x + event.clientX - previous.current.x, y: current.y + event.clientY - previous.current.y }); }
    ~   previous.current = { x: event.clientX, y: event.clientY };
    ~ }}
    ~ onPointerUp={releasePointer}
    ~ onPointerCancel={releasePointer}
    ~ onLostPointerCapture={releasePointer}
    ~ )
    if !loaded && !failed
      div.preview-status(role="status")
        Icon(name="spinner-ring" size={24})
        span Loading original…
    if failed
      div.preview-status(role="alert")
        Icon(name="image" size={32})
        p This image format cannot be previewed here.
        a.button-secondary(href={file.url} target="_blank" rel="noopener noreferrer") Open original
    img.preview-image(src={file.url} alt={file.name} draggable={false} decoding="async" hidden={failed} style={{ transform: `translate(${pan.x}px, ${pan.y}px) scale(${zoom}) rotate(${rotation}deg)`, opacity: loaded ? 1 : 0 }} onLoad={() => setLoaded(true)} onError={() => setFailed(true)})
  div.viewer-controls(aria-label="Image controls")
    button.icon-button(type="button" onClick={() => changeZoom(getZoom() - 0.25)} disabled={zoom <= 0.5} aria-label="Zoom out")
      Icon(name="zoom-out" size={20})
    span.zoom-value #{Math.round(zoom * 100)}%
    button.icon-button(type="button" onClick={() => changeZoom(getZoom() + 0.25)} disabled={zoom >= 5} aria-label="Zoom in")
      Icon(name="zoom-in" size={20})
    span.control-divider
    button.icon-button(type="button" onClick={() => setRotation((value) => (value + 90) % 360)} aria-label="Rotate image clockwise" title="Rotate")
      Icon(name="rotate" size={20})
    button.button-secondary(type="button" onClick={reset}) Fit
    small Pinch to zoom · Drag to pan
