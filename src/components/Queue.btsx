module
  "use strong";
  interface QueueProps {
    queue: QueueItem[];
    activeQueueCount: number;
    removeItem: (id: string) => void;
    retryItem: (id: string) => void;
    isOpen: boolean;
    onClose: () => void;
    onOpen: () => void;
    onView: (id: string) => void;
    onClear: () => void;
  }
import { STATUS_COPY } from '@/constants/meta'
import type { QueueItem } from '@/types/file'
import { formatBytes, getFileIcon } from '@/utils/helpers'
import CategoryPill from './CategoryPill.btsx'
import { Icon } from '@/lib/icons'
props { queue, activeQueueCount, removeItem, retryItem, isOpen, onClose, onOpen, onView, onClear }: QueueProps
setup
  const done = queue.filter((item) => item.status === 'done').length;
  const errors = queue.filter((item) => item.status === 'error').length;
  const summary = queue.length === 0 ? 'No uploads in this session' : activeQueueCount ? `${activeQueueCount} in progress · ${done} filed` : errors ? `${done} filed · ${errors} need attention` : `${done} ${done === 1 ? 'file' : 'files'} sorted & ready to view`;

if isOpen
  section.queue-panel(aria-labelledby="queue-title")
    header.queue-header
      span.queue-indicator(className={activeQueueCount ? 'is-live' : errors ? 'has-error' : 'is-done'})
        Icon(name={activeQueueCount ? 'upload' : errors ? 'alert-fill' : 'check'} size={21})
      div
        h2#queue-title #{queue.length === 0 ? 'Your upload activity' : activeQueueCount ? 'Your files are on their way' : errors ? 'Let’s finish filing' : 'All filed. All ready.'}
        p(role="status" aria-live="polite" aria-atomic="true") #{summary}
      button.icon-button(type="button" onClick={onClose} aria-label="Minimize upload activity")
        Icon(name="chevron-down" size={20})
    div.queue-items
      if queue.length === 0
        p.queue-empty Add a file to get started. Its progress and completion will appear here.
      each item in queue key item.id
        article.queue-item(className={item.status === 'done' ? 'is-done' : item.status === 'error' ? 'has-error' : ''})
          div.queue-thumbnail
            if item.previewUrl
              img(src={item.previewUrl} alt="" decoding="async" loading="lazy")
            else
              Icon(name={getFileIcon(item.file.name, item.file.type)} size={23})
          div.queue-item-content
            strong(title={item.file.name}) #{item.file.name}
            div.queue-item-status
              span #{item.status === 'reading' || item.status === 'filing' ? item.detail ?? STATUS_COPY[item.status] : STATUS_COPY[item.status]}
              if item.classification
                CategoryPill(category={item.classification.category})
            if item.status !== 'done' && item.status !== 'error'
              div.queue-progress
                div.progress-track(role="progressbar" aria-label={`${item.file.name}: ${STATUS_COPY[item.status]}`} aria-valuenow={Math.round(item.progress)} aria-valuemin={0} aria-valuemax={100})
                  span(className={item.status === 'filing' ? 'is-filing' : ''} style={{ width: `${item.progress}%` }})
                div.transfer-meta
                  span #{item.status === 'uploading' ? `${formatBytes(item.uploadedBytes ?? 0)} / ${formatBytes(item.totalBytes ?? item.file.size)}` : formatBytes(item.file.size)}
                  if item.status === 'uploading' && item.bytesPerSecond
                    span #{formatBytes(item.bytesPerSecond)}/s
                  span #{Math.round(item.progress)}%
            if item.error
              p.queue-error(role="alert") #{item.error}
            if item.status === 'done' && item.storedFile?.jev && ['review', 'unavailable', 'skipped'].includes(item.storedFile.jev.status)
              p.queue-warning Saved & ready to view. Review the folder classification.
            if item.status === 'done' && item.classification?.warning
              p.queue-warning #{item.classification.warning}
          div.queue-item-actions
            if item.status === 'done' && item.storedFile
              button.button-secondary(type="button" onClick={() => onView(item.storedFile!.id)}) View
            if item.status === 'error'
              button.button-secondary(type="button" onClick={() => retryItem(item.id)} aria-label={`Retry ${item.file.name}`}) Retry
            if item.status === 'queued' || item.status === 'error' || item.status === 'done'
              button.icon-button(type="button" onClick={() => removeItem(item.id)} aria-label={`Dismiss ${item.file.name}`})
                Icon(name="close" size={16})
    footer.queue-footer
      Icon(name="shield-check" size={15})
      span #{activeQueueCount ? 'Keep this tab open while we file your originals.' : 'Saved originals are available when you sign in on another device.'}
      if done > 0
        button.text-button(type="button" onClick={onClear}) Clear completed
else
  button.queue-dock(type="button" onClick={onOpen})
    Icon(name={activeQueueCount ? 'upload' : errors ? 'alert-fill' : 'check'} size={20})
    span #{summary}
    Icon(name="chevron-down" className="rotate-180" size={17})
