module
  "use strong";
  interface LibraryProps {
    filteredLibrary: StoredFile[];
    categoryCounts: Map<CategoryName, number>;
    activeCategory: CategoryName;
    setActiveCategory: (category: CategoryName) => void;
    search: string;
    selectedFileId: string | null;
    selectFile: (id: string) => void;
    onAddFiles: VoidFunction;
    loading: boolean;
    onRefresh: VoidFunction;
  }
  const skeletonCards = [1, 2, 3, 4, 5, 6];
  function formatFileDate(value: string) {
    return new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(value));
  }

import { useState } from 'octane'
import { CATEGORY_GROUPS, CATEGORY_NAMES, SHOW_EMPTY_FOLDERS } from '@/constants/meta'
import type { CategoryName, StoredFile } from '@/types/file'
import { formatBytes, getFileIcon } from '@/utils/helpers'
import CategoryPill from './CategoryPill.btsx'
import { Icon } from '@/lib/icons'

props { filteredLibrary, categoryCounts, activeCategory, setActiveCategory, search, selectedFileId, selectFile, onAddFiles, loading, onRefresh }: LibraryProps
setup
  const [viewMode, setViewMode] = useState<'list' | 'grid'>('grid');
  const [sort, setSort] = useState('newest');
  const [visibleCount, setVisibleCount] = useState(48);
  const sortedFiles = [...filteredLibrary].sort((a, b) => sort === 'name' ? a.name.localeCompare(b.name) : sort === 'size' ? b.size - a.size : Date.parse(b.createdAt) - Date.parse(a.createdAt));
  const visibleFiles = sortedFiles.slice(0, visibleCount);
  const populatedCategories = SHOW_EMPTY_FOLDERS ? CATEGORY_NAMES : CATEGORY_NAMES.filter((category) => (categoryCounts.get(category) ?? 0) > 0);

section.library(aria-labelledby="library-title" aria-busy={loading})
  header.library-header
    div
      span.eyebrow Your cloud library
      h2#library-title #{activeCategory === 'All' ? 'All files' : activeCategory}
        small #{filteredLibrary.length}
    div.library-tools
      button.icon-button(type="button" onClick={onRefresh} disabled={loading} aria-label="Refresh library" title="Refresh library")
        Icon(name={loading ? 'spinner-ring' : 'refresh'} size={14})
      label.sort-control
        span.sr-only Sort files
        select(value={sort} onChange={(event) => setSort(event.currentTarget.value)} aria-label="Sort files")
          option(value="newest") Newest first
          option(value="name") Name A–Z
          option(value="size") Largest first
      div.view-toggle(role="group" aria-label="File view")
        button.icon-button(className={viewMode === 'grid' ? 'is-active' : ''} type="button" onClick={() => setViewMode('grid')} aria-label="Grid view" title="Grid view" aria-pressed={viewMode === 'grid'})
          Icon(name="grid" size={18})
        button.icon-button(className={viewMode === 'list' ? 'is-active' : ''} type="button" onClick={() => setViewMode('list')} aria-label="List view" title="List view" aria-pressed={viewMode === 'list'})
          Icon(name="list" size={18})

  if loading && filteredLibrary.length === 0
    div.library-skeleton(aria-label="Loading files")
      each value in skeletonCards key value
        div.skeleton-card
  elseif filteredLibrary.length === 0
    div.empty-library
      span.empty-icon_
        Icon(name={search || activeCategory !== 'All' ? 'search' : 'new-folder'} size={50} className="text-accent")
      h3 #{search || activeCategory !== 'All' ? 'A fresh view, waiting for files' : 'Everything in its right place.'}
      p(className='text-balance') #{search || activeCategory !== 'All' ? 'Try another folder or search, or add a file to this workspace.' : 'Start with a receipt, photo, or document. We’ll take care of the sorting.'}
      button.button-primary(type="button" onClick={onAddFiles})
        Icon(name="add" size={12})
        | Upload files
  else
    fragment
      div.file-collection(className={viewMode === 'grid' ? 'file-grid' : 'file-list'})
        each file in visibleFiles key file.id
          button.file-card(className={selectedFileId === file.id ? 'is-selected' : ''} type="button" onClick={() => selectFile(file.id)} aria-label={`Preview ${file.name}, ${file.category}, ${formatBytes(file.size)}`} aria-pressed={selectedFileId === file.id})
            div.file-thumbnail
              if file.mimeType.startsWith('image/')
                img(src={file.thumbnailUrl ?? file.url} alt="" loading="lazy" decoding="async" onError={(event) => { event.currentTarget.hidden = true; }})
              Icon(name={getFileIcon(file.name, file.mimeType)} size={32})
              span.thumbnail-type #{file.name.split('.').pop()?.toUpperCase() ?? 'FILE'}
              span.preview-hint
                Icon(name="expand" size={17})
                | Preview
            div.file-info
              strong(title={file.name}) #{file.name}
              span.file-kind #{file.kind}
              CategoryPill(category={file.category})
              div.file-meta
                span #{formatBytes(file.size)}
                span #{formatFileDate(file.createdAt)}
            span.file-ready(title={file.warning ? 'Filed · review text extraction' : 'Filed and ready for remote viewing'})
              Icon(name={file.warning ? 'alert-fill' : 'check'} size={14})
      if visibleFiles.length < sortedFiles.length
        button.button-secondary.load-more(type="button" onClick={() => setVisibleCount((count) => count + 48)}) Show more files (#{sortedFiles.length - visibleFiles.length} remaining)
  footer.library-footer
    Icon(name="cloud" size={15})
    span Originals stored in the cloud. Text recognition happens on your device.
