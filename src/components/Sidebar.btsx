module
  "use strong";
  interface SidebarProps {
    activeQueueCount: number;
    library: StoredFile[];
    activeCategory: CategoryName;
    setActiveCategory: (category: CategoryName) => void;
    categoryCounts: Map<CategoryName, number>;
    search: string;
    setSearch: (value: string) => void;
    searchInputRef: { current: HTMLInputElement | null };
  }

import { CATEGORY_META } from '@/constants/meta'
import type { CategoryName, StoredFile } from '@/types/file'
import { formatBytes } from '@/utils/helpers'
import {Icon} from '@/lib/icons'
import {Button} from "./ui";

props { activeQueueCount, library, activeCategory, setActiveCategory, categoryCounts, search, setSearch, searchInputRef }: SidebarProps
setup
  const storageUsed = library.reduce((total, file) => total + file.size, 0);
  const visibleCategories = (Object.keys(CATEGORY_META) as CategoryName[])
    .filter((category) => category !== 'All' && (categoryCounts.get(category) ?? 0) > 0);


aside(className="flex h-full min-h-0 flex-col overflow-y-auto rounded-2xl border border-sidebar-border bg-surface pb-3 shadow-[0_1px_2px_rgba(25,31,55,0.04)] dark:gap-px dark:overflow-hidden dark:rounded-[4px] dark:rounded-bl-md dark:border-[0.33px] dark:border-[#050505] dark:bg-[#090909] dark:p-0 dark:shadow-none max-[820px]:hidden")
  div(className="contents dark:flex dark:min-h-0 dark:flex-1 dark:flex-col dark:overflow-y-auto dark:rounded-[4px] dark:bg-[#272727] dark:p-0 dark:shadow-[inset_0_1px_0_#393939,inset_-1px_0_0_#393939]")
    label(className="mb-3 px-1.5 hidden h-11 items-center gap-2 border-b-[0.33px] border-[#121212] bg-[#20202080] text-[#9a9a9a] shadow-[inset_0_1px_2px_#222] dark:flex focus-within:border-[#5a5a5a] [&_svg]:size-4")
      // Icon(name="search" size={12} className="size-3.5!")
      input(
        ~ className="min-w-0 flex-1 border-0 text-sm text-muted-foreground outline-none placeholder:text-[#777]"
        ~ ref={searchInputRef}
        ~ type="search"
        ~ value={search}
        ~ onInput={(event) => setSearch(event.currentTarget.value)}
        ~ placeholder="Search..."
        ~ aria-label="Search your files"
        ~ )
    nav(className="grid gap-1 [&>button]:grid [&>button]:h-10 [&>button]:w-full [&>button]:cursor-pointer [&>button]:grid-cols-[20px_minmax(0,1fr)_auto] [&>button]:items-center [&>button]:gap-2.5 [&>button]:rounded-[9px] [&>button]:border-0 [&>button]:bg-transparent [&>button]:px-[11px] [&>button]:text-left [&>button]:text-[12.5px] [&>button]:text-muted-foreground [&>button]:transition-all [&>button]:duration-150 [&>button:hover]:bg-accent/50 [&>button:hover]:text-foreground px-2" aria-label="File navigation")
      button(
        ~ className={activeCategory === 'All' ? 'text-brand! dark:!bg-[#3d3d3d] dark:!text-[#d2d2d2]' : 'hover:bg-accent/50'}
        ~ type="button"
        ~ onClick={() => setActiveCategory('All')}
        ~ )
        Icon(name="file-blank")
        | All files
        span(className={['inline-grid h-5 min-w-[22px] place-items-center rounded-full bg-muted px-1.5 text-[9.5px] font-bold text-muted-foreground', activeCategory === 'All' && 'bg-surface text-brand']}) #{library.length}
      button
        Icon(name="clock")
        | Recent
      button(type="button")
        Icon(name="favorite")
        | Favorites
      button(type="button")
        Icon(name="upload")
        | Uploads
        if activeQueueCount > 0
          span(className="inline-grid h-5 min-w-[22px] place-items-center rounded-full bg-brand px-1.5 text-[9.5px] font-bold text-brand-foreground") #{activeQueueCount}

    div(className="mt-6 dark:mt-4 px-1.5")
      div(className="flex items-center justify-between px-2 pb-[9px] text-[9.5px] font-[680] uppercase tracking-[0.09em] text-muted-foreground dark:text-[#aaa]")
        span Smart folders
        Icon(name="sparkles")
      div(className="grid gap-1")
        each category in visibleCategories key category
          button(
            ~ className={[
            ~   'grid h-[35px] w-full cursor-pointer grid-cols-[8px_minmax(0,1fr)_auto] items-center gap-2.5 rounded-lg border-0 bg-transparent px-[11px] text-left text-[11.5px] text-muted-foreground hover:bg-accent/50 hover:text-foreground [&>span:last-child]:text-[10px] [&>span:last-child]:text-muted-foreground',
            ~   activeCategory === category && 'bg-brand font-[650] text-foreground dark:bg-[#424242] dark:text-[#d2d2d2]'
            ~ ]}
            ~ type="button"
            ~ onClick={() => setActiveCategory(category)}
            ~ )
            span(className="size-[7px] rounded-full dark:!bg-[#777]" style={{ background: CATEGORY_META[category].color }})
            span #{category}
            span #{categoryCounts.get(category) ?? 0}
        empty
          p(className="mx-2.5 my-1.5 text-[10.5px] leading-[1.45] text-muted-foreground") Folders appear as files are sorted.

  div(className="mt-auto grid dark:mt-0 dark:shrink-0 dark:rounded-[4px] dark:bg-[#272727] dark:shadow-[inset_0_1px_0_#393939,inset_-1px_0_0_#393939]")
    nav(className="grid gap-1 [&>button]:grid [&>button]:h-10 [&>button]:w-full [&>button]:cursor-pointer [&>button]:grid-cols-[20px_minmax(0,1fr)_auto] [&>button]:items-center [&>button]:gap-2.5 [&>button]:rounded-[9px] [&>button]:border-0 [&>button]:bg-transparent [&>button]:px-[11px] [&>button]:text-left [&>button]:text-[12.5px] [&>button]:text-muted-foreground [&>button]:transition-all [&>button]:duration-150 [&>button:hover]:bg-accent [&>button:hover]:text-foreground" aria-label="Account navigation")
      button(type="button" className="rounded-t-[4px]! dark:bg-accent rounded-b-[2px]! h-12!")
        Icon(name="settings")
        | Settings

    div(className="rounded-[11px] dark:rounded-bl-[4px] dark:rounded-se-none border-y border-border bg-card p-4 dark:rounded-e-none dark:rounded-ss-none dark:rounded-rb-none dark:rounded-rt-[4px] dark:bg-[#222]")
      div(className="flex items-center justify-between text-[10px] text-muted-foreground")
        span(className="inline-flex items-center gap-[7px] font-[630] text-foreground")
          Icon(name="cloud" className="opacity-50")
          | Cloud
        span(className=" text-muted-foreground") #{formatBytes(storageUsed)}
        span #{library.length} #{library.length <= 1 ? ' file' : ' files'}
