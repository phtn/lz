module "use strong";

import type { WorkspaceNavigationProps } from '@/types/layout'
import { formatBytes } from '@/utils/helpers'
import ThemeToggle from './ThemeToggle.btsx'
import SidebarNav from './SidebarNav.btsx'
import {Icon} from "@/lib/icons";

props { isCompact = false, toggleSidebar, ...navigation }: WorkspaceNavigationProps & { isCompact?: boolean; toggleSidebar: VoidFunction }
setup const storageUsed = navigation.library.reduce((total, file) => total + file.size, 0);

aside.sidebar(aria-label="Workspace sidebar" data-compact={isCompact || undefined})
  div.sidebar-header
    button.sidebar-toggle(type="button" onClick={toggleSidebar} aria-label={isCompact ? 'Expand sidebar' : 'Collapse sidebar'} aria-expanded={!isCompact} title={isCompact ? 'Expand sidebar' : 'Collapse sidebar'})
      span(aria-hidden="true")
  SidebarNav({...navigation} isCompact={isCompact} onExpand={toggleSidebar})
  footer.sidebar-footer
    ThemeToggle
    div(className='flex items-center gap-1')
      span.storage-summary(title={`${formatBytes(storageUsed)} stored · ${navigation.library.length} files · OCR stays on your device`}) #{formatBytes(storageUsed)}
      Icon(name='cloud' size={14})
