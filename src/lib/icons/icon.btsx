module "use strong";

import { trustHTML, useId } from 'octane'
import { ICON_VIEWBOX, iconMarkup } from '@/lib/icons/icons'
import type { IconProps } from '@/lib/icons/types'

props { name, size = 20, className, color, label }: IconProps

setup
  const instanceId = useId()

svg(
  ~ xmlns="http://www.w3.org/2000/svg"
  ~ viewBox={ICON_VIEWBOX}
  ~ width={size}
  ~ height={size}
  ~ fill="currentColor"
  ~ strokeLinecap="round"
  ~ strokeLinejoin="round"
  ~ className={[className, name === 'spinner-ring' || name === 'spinner-shuffle' ? 'animate-spin' : undefined]}
  ~ style={{ flexShrink: 0, color }}
  ~ role={label ? 'img' : undefined}
  ~ aria-label={label}
  ~ aria-hidden={label ? undefined : true}
  ~ dangerouslySetInnerHTML={trustHTML(iconMarkup(name, instanceId))}
  ~ )
