
import '@/style.css'
import { use, useSyncExternalStore } from 'octane'
import { loadInitialState } from 'server'
import LandingPage from '@/components/LandingPage.btsx'
import FileDashboard from '@/components/FileDashboard.btsx'
import { getAuthStateReady, getCurrentUser, getServerAuthStateReady, getServerAuthUser, subscribeToAuthState } from '@/lib/firebase'
import {Icon} from '@/lib/icons'
import ThemeProvider from '@/components/ThemeProvider.btsx'

module
  module server {
    import type { StoredFile } from '@/types/file';

    export async function loadInitialState() {
      return {
        library: [] as StoredFile[],
        socialImage: '/dropzone.webp'
      };
    }
  }

component AuthLoading
  main(className="grid min-h-screen place-items-center p-6" role="status" aria-label="Loading workspace")
    Icon(name="spinner-ring" className="text-muted-foreground [&_svg]:animate-spin [&_svg]:[animation-duration:900ms]")
    span.sr-only Opening your workspace…

component Dashboard
  setup
    const initialState = use(loadInitialState());
    const currentUser = useSyncExternalStore(subscribeToAuthState, getCurrentUser, getServerAuthUser);
    const ready = useSyncExternalStore(subscribeToAuthState, getAuthStateReady, getServerAuthStateReady);
  fragment
    meta(property="og:image" content={initialState.socialImage})
    meta(name="twitter:image" content={initialState.socialImage})
    ThemeProvider
      div.app-view
        if !ready
          AuthLoading
        elseif currentUser
          FileDashboard(initialLibrary={initialState.library})
        else
          LandingPage(authReady={ready})

fragment
  meta(
    ~ name="description"
    ~ content="Drop files, classify their contents with private on-device OCR, and keep every document organized automatically."
    ~ )
  meta(property="og:title" content="DropZone — Drop it. We'll sort it.")
  meta(
    ~ property="og:description"
    ~ content="Private on-device OCR, live cloud uploads, and files organized for every device."
    ~ )
  meta(property="og:type" content="website")
  meta(name="twitter:card" content="summary_large_image")
  meta(name="twitter:title" content="DropZone — Drop it. We'll sort it.")
  meta(
    ~ name="twitter:description"
    ~ content="Private on-device OCR, live cloud uploads, and files organized for every device."
    ~ )
  try
    Dashboard
  pending
    AuthLoading
  catch error
    main(className="grid min-h-screen place-items-center p-6" role="alert")
      div(className="grid justify-items-center gap-3 text-center text-muted-foreground [&_h1]:m-0 [&_p]:m-0")
        h1 DropZone could not start
        p #{error instanceof Error ? error.message : 'Please refresh and try again.'}
