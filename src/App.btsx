
import { use } from 'octane'
import { loadInitialState } from 'server'
import FileDashboard from '@/components/FileDashboard.btsx'
import {Icon} from '@/lib/icons'
import ThemeProvider from '@/components/ThemeProvider.btsx'

module
  module server {
    import type { StoredFile } from './types/file';

    export async function loadInitialState() {
      return {
        library: [] as StoredFile[],
        storageNotice: '',
        socialImage: '/dropzone-og.png'
      };
    }
  }

component Dashboard
  setup const initialState = use(loadInitialState());
  fragment
    meta(property="og:image" content={initialState.socialImage})
    meta(name="twitter:image" content={initialState.socialImage})
    ThemeProvider
      FileDashboard(initialLibrary={initialState.library} initialStorageNotice={initialState.storageNotice})

fragment
  meta(
    ~ name="description"
    ~ content="Drop files, classify their contents with private on-device OCR, and keep every document organized automatically."
    ~ )
  meta(property="og:title" content="DropZone — Drop it. We'll sort it.")
  meta(
    ~ property="og:description"
    ~ content="Private, local-first file classification with a fast multi-file upload queue."
    ~ )
  meta(property="og:type" content="website")
  meta(name="twitter:card" content="summary_large_image")
  meta(name="twitter:title" content="DropZone — Drop it. We'll sort it.")
  meta(
    ~ name="twitter:description"
    ~ content="Private, local-first file classification with a fast multi-file upload queue."
    ~ )
  try
    Dashboard
  pending
    main(className="grid min-h-screen place-items-center p-6" aria-label="Loading file library")
      div(className="grid justify-items-center gap-3 text-center text-muted-foreground [&_h1]:m-0 [&_p]:m-0")
        Icon(name="spinner-ring" className="[&_svg]:animate-spin [&_svg]:[animation-duration:900ms]")
        p Opening your file library…
  catch error
    main(className="grid min-h-screen place-items-center p-6" role="alert")
      div(className="grid justify-items-center gap-3 text-center text-muted-foreground [&_h1]:m-0 [&_p]:m-0")
        h1 DropZone could not start
        p #{error instanceof Error ? error.message : 'Please refresh and try again.'}
